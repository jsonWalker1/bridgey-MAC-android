<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets DiscoveryController register a ConnectivityManager network callback so it can restart
         mDNS discovery immediately when Wi-Fi reconnects, instead of waiting on the plain reconnect
         backoff. Without this, registerNetworkCallback throws SecurityException, is caught and only
         logged ("could not register network callback"), and that recovery path silently never runs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- BRIDGEY VIDEO REGRESSION WAKELOCK EXPERIMENT (2026-09-24): lets ScreenCaptureManager hold a
         SCREEN_DIM_WAKE_LOCK for the duration of an active Screen Share session, testing the
         hypothesis that the phone's screen timing out/locking during an idle session destabilizes
         the pairing TCP connection. Normal (non-dangerous) permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- BRIDGEY KVM KEYBOARD V1 (switch shortcut): lets KvmKeyboardSwitcher write
         Settings.Secure.DEFAULT_INPUT_METHOD directly (the same mechanism `adb shell ime set` uses) so
         the Mac's Command+K shortcut can toggle the active keyboard with no manual Settings trip. A
         signature/system permission - not grantable through the normal install flow or app Settings
         UI - the user grants it once via `adb shell pm grant dev.bridgey.android
         android.permission.WRITE_SECURE_SETTINGS`. Without it granted, KvmKeyboardSwitcher falls back
         to the standard system keyboard picker (one tap) instead of failing silently. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Pocket Mode's touch guard: a fully transparent, non-rendering overlay window that only
         intercepts touches while Screen Share is active and the feature is explicitly opted in.
         Standard "special app access" permission granted via Settings, not a hidden/hacky API. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets a granted "Do Not Disturb access" (requested separately via Settings, see
         requestRemoteScreenShare) actually bypass DND for the Remote Start notification channel -
         the same standard mechanism alarm/call apps use, not a hidden or forced bypass. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- BRIDGEY SMB POC (feasibility spike only, see SmbPocServer.kt) - lets SmbPocService run as a
         foreground service so the embedded SMB server survives backgrounding, same requirement as
         BridgeyConnectionService/ScreenCaptureService elsewhere in this app. DELETE alongside the
         Smb*.kt files and the <activity>/<service> entries below to remove the POC entirely. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Part 3 KVM: BIND_ACCESSIBILITY_SERVICE needs no <uses-permission> declaration here (it is
         declared on the <service> below); the service only becomes active once the user explicitly
         enables it under Settings > Accessibility, same as any accessibility/remote-support app
         (TeamViewer, AnyDesk QuickSupport). The cursor overlay reuses Pocket Mode's already-declared
         SYSTEM_ALERT_WINDOW permission above - no new permission needed for it either. -->

    <!-- Media Continuity resolves a human-readable app name (e.g. "YouTube", "Spotify") for
         whatever app owns the current MediaSession, so it can show that instead of a raw package
         name. Package visibility restrictions (API 30+) would otherwise silently fail that lookup
         for any third-party app Bridgey doesn't already have visibility into. This intentionally
         targets "any launchable app" rather than naming specific media apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BridgeyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bridgey">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:documentLaunchMode="never"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- WEB HANDOFF ALPHA: Share → "Continue on Mac" (text/URLs only, no UI). Exported because the
             system share sheet launches it; it only ever sends an http(s) link to the paired Mac. -->
        <activity
            android:name=".WebHandoffShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/web_handoff_share_label"
            android:noHistory="true"
            android:taskAffinity="dev.bridgey.android.web_handoff"
            android:theme="@style/Theme.Bridgey.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ClipboardCaptureActivity"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="dev.bridgey.android.clipboard_action"
            android:theme="@style/Theme.Bridgey.Transparent" />
        <activity
            android:name=".OpenReceivedFileActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="" />
        <activity android:name=".ConfirmCallActivity" android:exported="false"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" />
        <service
            android:name=".BridgeyConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <receiver android:name=".BootCompletedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".ClipboardTileService" android:exported="true"
            android:label="Bridgey clipboard" android:icon="@drawable/ic_bridgey_notification"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- BOOKS HANDOFF ALPHA: "Continue reading on Mac" tile. -->
        <service android:name=".BooksHandoffTileService" android:exported="true"
            android:label="@string/books_handoff_tile_label" android:icon="@drawable/ic_bridgey_notification"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".BridgeyNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_forwarding_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- BRIDGEY WEB HANDOFF POC (experimental, not production) - see WebHandoffPocService.kt.
             Separate opt-in accessibility service limited to browser packages. -->
        <service
            android:name=".WebHandoffPocService"
            android:exported="true"
            android:label="@string/web_handoff_poc_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/web_handoff_poc_service_config" />
        </service>
        <!-- Part 3 KVM POC input-injection layer - see BridgeyAccessibilityService's doc comment.
             Requires explicit, revocable user enablement under Settings > Accessibility; only ever
             dispatches gestures, never inspects window/content (see canRetrieveWindowContent below
             and the config's minimal eventTypes). -->
        <service
            android:name=".BridgeyAccessibilityService"
            android:exported="false"
            android:label="@string/kvm_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kvm_accessibility_service_config" />
        </service>
        <!-- Part 3 KVM POC #2 keyboard-injection test. Requires the user to explicitly enable and
             switch to this keyboard under Settings > System > Languages & input > Manage keyboards -
             the same standard mechanism any third-party keyboard app uses. -->
        <!-- BRIDGEY SMB POC (feasibility spike only, see SmbPocServer.kt's doc comment). Launch via
             `adb shell am start -n dev.bridgey.android/.SmbPocActivity` - never linked from any
             production UI. Delete this activity + the service below + the three Smb*.kt files to
             remove the POC entirely. -->
        <activity
            android:name=".SmbPocActivity"
            android:exported="true"
            android:label="Bridgey SMB POC" />
        <service
            android:name=".SmbPocService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".BridgeyInputMethodService"
            android:exported="false"
            android:label="@string/kvm_input_method_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/kvm_input_method" />
        </service>
    </application>
</manifest>
